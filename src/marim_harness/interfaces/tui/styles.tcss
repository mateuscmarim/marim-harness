/* The harness's layout + chrome styling. Colors come exclusively from theme
   variables so switching the theme recolors everything. Keep it free of
   hard-coded colors. */

#log { height: 1fr; padding: 0 1; }

/* The input carries the accent as a persistent frame. The box border eats two
   rows (top + bottom), so the height here and PromptInput._resize both add 2 to
   the desired text-line count to keep the visible text area at its [3, 10]
   window. */
PromptInput { height: 5; max-height: 12; border: round $accent; padding: 0 1; }

#status-bar { height: 1; background: $panel; color: $text-muted; padding: 0 1; }

#task-panel {
    height: auto; max-height: 8; background: $panel; color: $text;
    padding: 0 1; border-top: tall $background;
}

#job-panel {
    height: auto; max-height: 8; background: $panel; color: $text;
    padding: 0 1; border-top: tall $background;
}

.user-msg { color: $accent; text-style: bold; margin-top: 1; }
.error-msg { color: $error; text-style: bold; margin: 1 0; }
.notice-msg { color: $text-muted; text-style: italic; margin: 1 0; }
.turn-meta { color: $text-muted; text-style: dim; margin: 0 0 1 0; }

/* Two-column intro header (Claude-style): the accent block-ASCII banner on the
   left, the welcome/resume text on the right behind a vertical accent divider,
   the whole row seated above a thin accent rule that splits it from the chat. */
#intro-header { height: auto; margin: 1 0 1 0; border-bottom: solid $accent; }
#banner { color: $accent; height: auto; width: auto; padding: 0 2 0 0; }
#intro-header AssistantMessage {
    width: 1fr; height: 100%; margin: 0; padding: 0 0 0 2; border-left: solid $accent;
}

AssistantMessage { margin: 0 0 1 0; }
ToolCallWidget { margin: 0 0 1 0; border-left: tall $primary; padding-left: 1; }
SubAgentWidget { margin: 0 0 1 0; }
.subagent-body { height: auto; padding: 0 0 0 2; border-left: tall $primary; }
ToolGroupWidget { margin: 0 0 1 0; }
/* Indent the group's children and drop their inter-row gap so a run of tools
   reads as one compact cluster (the per-child accent rail still separates them)
   instead of sprawling a blank line between each. */
.tool-group-body { height: auto; padding: 0 0 0 2; }
/* margin:0 + drop Collapsible's default 1-row hkey top border so the rows sit
   flush; the per-child accent rail (border-left) still delineates them. */
.tool-group-body ToolCallWidget { margin: 0; border-top: none; }

/* A focused collapsible title is cued with bold accent text rather than a filled
   band, which otherwise reads like a stuck selection. */
CollapsibleTitle:focus { background: transparent; color: $accent; text-style: bold; }

/* Slash-command autocomplete dropdown.  Docked to the screen bottom (same
   edge as the Footer), offset upward so it sits directly above the prompt.
   The offset value: -(footer=1 + prompt-border-top=1 + prompt-min-height=3
   + prompt-border-bottom=1) = -6.  Uses layer:overlay so it floats above
   sibling content without pushing the layout. */
#cmd-autocomplete {
    display: none;
    layer: overlay;
    dock: bottom;
    width: 60;
    max-height: 8;
    offset: 0 -6;
    background: $panel;
    border: round $accent;
}
#cmd-autocomplete.visible {
    display: block;
}
#cmd-options {
    height: auto;
    max-height: 6;
    background: $panel;
}

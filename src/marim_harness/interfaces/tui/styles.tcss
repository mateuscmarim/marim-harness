/* The harness's layout + chrome styling. Colors come exclusively from theme
   variables so switching the theme recolors everything. Keep it free of
   hard-coded colors. */

/* Layer stack: base chrome, then the sub-agent transcript overlay, then its
   side panel + footer on top of that (see the sub-agent viewer rules below). */
Screen { layers: base subagents subagents-top; }

#log { height: 1fr; padding: 0 1; }

/* The input carries the accent as a persistent frame. The box border eats two
   rows (top + bottom), so the height here and PromptInput._resize both add 2 to
   the desired text-line count to keep the visible text area at its [1, 6]
   window. The opening height matches _MIN_LINES (1) + 2 so the box starts at its
   minimum instead of rendering tall and snapping down on first resize. */
PromptInput { height: 3; max-height: 8; border: round $accent; padding: 0 1; }

#status-bar { height: 1; background: $panel; color: $text-muted; padding: 0 1; }

/* Task/Jobs panel styling lives in LivePanel.DEFAULT_CSS (widgets/panels.py). */

.user-msg { color: $accent; text-style: bold; margin-top: 1; }
.error-msg { color: $error; text-style: bold; margin: 1 0; }
.notice-msg { color: $text-muted; text-style: italic; margin: 1 0; }
.turn-meta { color: $text-muted; text-style: dim; margin: 0 0 1 0; }

/* Reasoning shown inline behind an accent rail, italic + muted so it reads as
   an aside to the reply. The "Thinking:" label carries its own colour inline. */
.thinking { margin: 1 0 1 0; padding: 0 0 0 2; color: $text-muted; text-style: italic; }

/* Two-column intro header (Claude-style): the accent block-ASCII banner on the
   left, the welcome/resume text on the right behind a vertical accent divider,
   the whole row seated above a thin accent rule that splits it from the chat. */
#intro-header { height: auto; margin: 1 0 1 0; border-bottom: solid $accent; }
#banner { color: $accent; height: auto; width: auto; padding: 0 2 0 0; }
#intro-header AssistantMessage {
    width: 1fr; height: 100%; margin: 0; padding: 0 0 0 2; border-left: solid $accent;
}

AssistantMessage { margin: 0 0 1 0; }
/* Markdown gives every paragraph a 1-row bottom margin; on the message's final
   block that stacks with AssistantMessage's own margin-bottom, doubling the gap
   before the next widget (e.g. a tool group). Drop the trailing block's margin
   so a single row separates the prose from what follows. */
AssistantMessage > MarkdownBlock:last-child { margin-bottom: 0; }
ToolCallWidget { margin: 0 0 1 0; border-left: tall $primary; padding-left: 1; background: transparent; }
/* update_tasks renders as a muted breadcrumb: same column as tool rows (the border
   keeps the indent) but the accent recedes, so it reads as a status marker. */
ToolCallWidget.tool-breadcrumb { border-left: tall $panel; }
ToolCallWidget > CollapsibleTitle, ToolGroupWidget > CollapsibleTitle { background: transparent; }
ToolGroupWidget { margin: 0 0 1 0; background: transparent; }
/* Sub-agent compact card (inline in the log): a single-line header and an
   indented ↳ progress line (toolcalls · duration). Muted by default, brightening
   to white + bold on hover (the whole row, since :hover propagates to the card).
   The header clips to one line with an ellipsis. The full transcript lives in
   .subagent-body, hidden inline and revealed full-screen by the viewer (ctrl+x). */
SubAgentWidget { margin: 0 0 1 0; height: auto; padding-left: 2; }
.subagent-header { height: 1; text-wrap: nowrap; text-overflow: ellipsis; color: $text-muted; }
.subagent-activity { height: 1; padding-left: 2; color: $text-muted; }
/* Brighten the whole row to white + bold on hover. Driven by a `-hovered` class
   the card toggles from its own mouse state (CSS :hover only lands on the leaf
   line under the pointer, not the container — see SubAgentWidget.on_enter). */
SubAgentWidget.-hovered .subagent-header,
SubAgentWidget.-hovered .subagent-activity { color: white; text-style: bold; }
.subagent-bhead { color: $accent; text-style: bold; margin: 0 0 1 0; }
.subagent-usage { color: $text-muted; }
.subagent-error { color: $error; margin: 1 0 0 0; }

/* The transcript home. Hidden inline (display toggled in Python); the `viewing`
   class promotes it to a full-screen overlay docked above the log, leaving a gap
   on the left for the docked side panel. */
.subagent-body { height: auto; }
.subagent-body.viewing {
    layer: subagents;
    dock: top;
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 1 2 1 38;
}

/* Viewer chrome — the master list (left) and status footer (bottom). Both start
   hidden; the app shows them by setting display while the viewer is open. */
#subagent-list {
    display: none;
    layer: subagents-top;
    dock: left;
    width: 36;
    height: 100%;
    background: $panel;
    border-right: solid $accent;
    padding: 1;
}
#subagent-footer {
    display: none;
    layer: subagents-top;
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

/* Indent the group's children and drop their inter-row gap so a run of tools
   reads as one compact cluster (the per-child accent rail still separates them)
   instead of sprawling a blank line between each. */
.tool-group-body { height: auto; padding: 0 0 0 2; }
/* margin:0 + drop Collapsible's default 1-row hkey top border so the rows sit
   flush; the per-child accent rail (border-left) still delineates them. */
.tool-group-body ToolCallWidget { margin: 0; border-top: none; }

/* A focused collapsible title is cued with bold accent text rather than a filled
   band, which otherwise reads like a stuck selection. */
CollapsibleTitle:focus { background: transparent; color: $accent; text-style: bold; }

/* Slash-command autocomplete dropdown.  Docked to the screen bottom (same
   edge as the Footer), offset upward so it sits directly above the prompt.
   The offset value: -(footer=1 + prompt-border-top=1 + prompt-min-height=1
   + prompt-border-bottom=1) = -4.  Uses layer:overlay so it floats above
   sibling content without pushing the layout. */
#cmd-autocomplete {
    layer: overlay;
    dock: bottom;
    width: 60;
    max-height: 8;
    offset: 0 -4;
    background: $panel;
    border: round $accent;
}
#cmd-options {
    height: auto;
    max-height: 6;
    background: $panel;
}

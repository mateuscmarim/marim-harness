__pycache__/
*.pyc
.venv/
.env

# Tool caches / generated reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.VSCodeCounter/

# Coverage artifacts from the test runner
.coverage
coverage.xml

# Offloaded fetch_url bodies — large pages written to disk so they don't flood
# context. Local scratch, never committed.
.marim/fetch/
.marim/output/

# Over-budget sub-agent reports spilled to disk by the output cap. Local scratch.
.marim/subagent-output/

# Git worktrees created by --worktree / the /worktree command.
.worktrees/
.claude/worktrees/

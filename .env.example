# Copy this file to .env and fill in your values. .env is gitignored.
# Real shell environment variables take priority over .env.

# --- OpenRouter (default provider) ---
OPENROUTER_API_KEY=

# Optional: override the default model (anthropic/claude-sonnet-4-6)
# MARIM_MODEL=anthropic/claude-sonnet-4-6

# --- Local provider (any OpenAI-compatible server) instead of OpenRouter ---
# The model picker (and `marim models list`) discovers models from the server's
# /v1/models endpoint, so MARIM_MODEL is optional once the server is reachable.
# Ollama:
# MARIM_PROVIDER=local
# MARIM_MODEL=qwen2.5-coder
# MARIM_BASE_URL=http://localhost:11434/v1
# MARIM_API_KEY=local
# LM Studio (note the 1234 port; start the server from the Developer tab):
# MARIM_PROVIDER=local
# MARIM_BASE_URL=http://localhost:1234/v1
# MARIM_API_KEY=lmstudio

# --- Multiple providers at once ---
# Any provider whose credentials are present is auto-detected and its models are
# merged into one tagged picker list (filter by id, name, or provider). Set
# several at once; MARIM_PROVIDER selects the default (startup model + the target
# for a typed model id with no provider prefix). Pick another provider's model in
# the picker, or type a qualified id like:  local:qwen2.5-coder

# --- Claude subscription via the claude CLI (Claude Code) ---
# Use a Claude Pro/Max subscription via the `claude` CLI (Claude Code must be
# installed and logged in). In this provider marim delegates the whole turn to
# `claude -p`: Claude runs its own tools/loop, so marim's own tools, approval
# gating, LSP, and MCP do not apply. `auto`/`ask` map to acceptEdits, `plan` to
# read-only plan. MARIM_MODEL is optional (sonnet/opus/haiku; default: CLI's own).
# MARIM_PROVIDER=claude-cli
# MARIM_MODEL=sonnet
# MARIM_CLAUDE_CLI_BIN=claude   # override the binary if not on PATH

# --- Context window & budget ---
# Compaction/masking trigger at min(budget, 0.8 × the model's context window).
# The window is discovered from the provider (catalog / LM Studio probe); the
# budget is your spend ceiling in tokens. 0 = unbudgeted (window-only).
# Replaces the deprecated MARIM_MAX_CONTEXT_TOKENS (same meaning).
# MARIM_CONTEXT_BUDGET=100000
# Manual window override (tokens) for servers discovery can't read, e.g. a
# non-LM-Studio local server; always wins over discovery.
# MARIM_CONTEXT_WINDOW=131072
# Per-model budgets: comma-separated fnmatch pattern=tokens pairs matched
# against the model id, first match wins; =0 means unbudgeted for that model.
# MARIM_CONTEXT_BUDGETS=anthropic/claude-opus*=60000,openrouter/*free*=0

# --- Web search (SearXNG) ---
# The web_search tool queries this SearXNG instance. Override to point at your
# own/self-hosted instance; defaults to https://searxng.marim.dev. The instance
# must have the JSON output format enabled (SearXNG disables it by default).
# MARIM_SEARXNG_URL=https://searxng.marim.dev

# --- Google (Gemini) ---
# MARIM_PROVIDER=google
# MARIM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=            # or GEMINI_API_KEY / MARIM_API_KEY

# --- OpenCode Zen (opencode's model gateway; free models available) ---
# MARIM_PROVIDER=zen
# OPENCODE_API_KEY=            # or MARIM_API_KEY
# MARIM_MODEL=mimo-v2.5-free   # default; other free ids: big-pickle, deepseek-v4-flash-free, ...

# --- OpenCode Go (Zen's flat-rate subscription plan; open coding models) ---
# Same OPENCODE_API_KEY as zen — the subscription changes billing, not the key.
# MARIM_PROVIDER=zen-go
# MARIM_MODEL=glm-5.2          # default; catalog: kimi-k3, minimax-m3, deepseek-v4, qwen, ...

# --- Session & UI ---
# Initial approval mode for interactive sessions: ask (default), auto, or plan.
# Ignored when set from a project .env — a cloned repo must not self-elevate.
# MARIM_DEFAULT_MODE=ask
# DEBUG logging to the log file (also enables spawn timing lines).
# MARIM_DEBUG=1
# Detached fan-out: spawn_agent with `background` unset auto-detaches in the
# TUI (live cards + job handles) instead of running inline. On by default.
# MARIM_DETACH_FANOUT=1
# Desktop notifications: on by default; pick events from turn_complete,
# error, approval_needed, ask_user, job_done (default: all but job_done).
# MARIM_NOTIFICATIONS=0
# MARIM_NOTIFICATION_EVENTS=approval_needed,ask_user
# Autonomous wake: finished background jobs start a new turn to deliver their
# reports while you're away; the depth cap bounds chained wakes.
# MARIM_AUTONOMOUS_WAKE=1
# MARIM_WAKE_DEPTH_CAP=8

# --- Command policy (bash tool) ---
# Comma-separated command prefixes to always allow / always block, checked
# before the built-in policy.
# MARIM_COMMAND_ALLOWLIST=git status,ls
# MARIM_COMMAND_DENYLIST=rm -rf

# --- Trust (project-local executable config) ---
# Project-local hooks (.marim/hooks.json), MCP servers (.marim/mcp.json), and
# project-scope plugins launch code from the repo on startup. They load only
# when the project is trusted. Trust is normally a persistent per-project
# decision (the TUI's first-open prompt, /trust, `marim trust grant/revoke`,
# or POST /v1/workspaces/{ws}/trust — see docs/guides/trust.md) stored outside
# the repo, not this env var. This var is a tri-state override on top of that
# store: unset falls through to the stored decision; a truthy value (1/true/
# on/yes) forces trusted; any other set value (0/false/...) forces UNTRUSTED,
# even over a store entry that says trusted. Leave it unset for repos you
# don't fully trust rather than setting it to a falsy value "to be safe" —
# unset is what lets the store's own decision (and re-prompting on a changed
# surface) take effect.
# MARIM_TRUST_PROJECT_HOOKS=1

# --- LSP ---
# Language-server integration: MARIM_LSP gates the manager + diagnostics on
# write/edit; MARIM_LSP_TOOLS gates the six navigation tools. Both on by
# default; 0 disables.
# The four bundled language plugins (python, typescript, cpp, java; see
# docs/lsp-plugins.md) always load regardless of trust. Third-party plugins
# that add a language via an `lsp` manifest block follow the same
# MARIM_TRUST_PROJECT_HOOKS gate as project-local hooks/MCP servers above.
# MARIM_LSP=1
# MARIM_LSP_TOOLS=1

# --- Forge (Gitea/GitHub) ---
# Forge (Gitea/GitHub) tools via the tea CLI; on by default. Set to 0 to disable.
# MARIM_FORGE=1

# --- Scratchpad ---
# Session scratchpad: a per-session /tmp directory the agent uses for
# intermediate files (advertised in the prompt; writes there skip approval
# in ask mode). 1 (default) or 0.
# MARIM_SCRATCHPAD=1

# --- TUI math rendering ---
# Render LaTeX math in replies ($..$, $$..$$, \(..\), \[..\]) as Unicode
# approximations (α² + √β) in the TUI. Needs flatlatex (part of the [tui]
# extra). 1 (default) or 0; the transcript on disk always keeps raw LaTeX.
# MARIM_TUI_MATH=1

# --- Dynamic workflows ---
# Dynamic workflows (the run_workflow tool; needs the [workflows] extra). Default on.
# MARIM_WORKFLOWS=1
# Ceiling (seconds) on the wall-clock budget one run_workflow call may request
# via its timeout_secs parameter. Default 1800 (30 min).
# MARIM_WORKFLOW_TIMEOUT=1800

# --- Compaction / observation masking ---
# Elide bulky, stale tool observations at compaction time (keep the newest N
# payloads; only bodies over the char floor are masked). On by default.
# MARIM_MASK_OBSERVATIONS=0
# MARIM_MASK_KEEP_RECENT=4
# MARIM_MASK_MIN_CHARS=200

# --- Sub-agents ---
# Cap concurrent spawn model-runs (default 8; 0 = unbounded) / per-spawn request
# budget (default 50) / persisted transcript size in messages (default 2000).
# MARIM_SUBAGENT_CONCURRENCY=8
# MARIM_SUBAGENT_REQUEST_LIMIT=50
# MARIM_SUBAGENT_TRANSCRIPT_CAP=2000
# Sub-agent model tiers: the model each tier routes to (qualified provider:model_id).
# A read-only spawn defaults to cheap, a mutating one to high; a spec's `tier:` or
# the spawner's tier= override picks explicitly. Unset ⇒ inherit the main model.
# MARIM_SUBAGENT_TIER_CHEAP=local:ornith-1.0-9b
# MARIM_SUBAGENT_TIER_MED=openrouter:anthropic/claude-sonnet-4-6
# MARIM_SUBAGENT_TIER_HIGH=openrouter:anthropic/claude-opus-4
# Master switch for tier routing. 0 ⇒ every spawn inherits the main model while
# the tier slugs above stay configured (toggle back on to restore routing). The
# TUI settings checkbox applies this live. Default on.
# MARIM_SUBAGENT_TIERING=1

# --- Advisor ---
# A model the agent can consult mid-task for strategic guidance (the advisor
# tool): qualified provider:model_id, or a bare slug for the default provider.
# Unset = no advisor (the tool is not offered to the model).
# MARIM_ADVISOR_MODEL=openrouter:anthropic/claude-opus-4.8
# Output cap per consultation (default 2048).
# MARIM_ADVISOR_MAX_TOKENS=2048
# Per-turn call cap. Unset or 0 = unlimited.
# MARIM_ADVISOR_MAX_USES=3

# --- Thinking level (reasoning effort) ---
# Reasoning effort applied to the model via ModelSettings.thinking. One of:
# off, minimal, low, medium, high, xhigh. Unset or 'off' = no reasoning effort
# (marim's default). /think overrides it per session, live.
# MARIM_THINKING=medium

# Claude Code model for `backend: claude-cli` sub-agents (alias or full id).
# MARIM_CLAUDE_CLI_MODEL=sonnet
# Proactive memory: the agent saves/recalls notes unprompted (off by default).
# MARIM_PROACTIVE_MEMORY=1

# --- MCP tool search ---
# Defer a large MCP/plugin tool surface behind a searchable index instead of
# advertising every tool: on, off, or auto (defer above the threshold).
# MARIM_TOOL_SEARCH=auto
# MARIM_TOOL_SEARCH_THRESHOLD=15

# --- Misc ---
# Combined `job(action, …)` tool instead of the four jobs/job_output/
# wait_for_job/cancel_job tools (for models that handle fewer tools better).
# MARIM_JOB_TOOL_COMBINED=1
# Where pasted-image bytes are cached (content-addressed, per session).
# MARIM_IMAGE_CACHE_DIR=~/.marim/image-cache
